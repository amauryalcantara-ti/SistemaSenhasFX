<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.sistemasenhas.views.admin.AdminController">

    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="65.0" spacing="20.0" style="-fx-background-color: #1a237e; -fx-padding: 0 20 0 20;">
            <children>
                <Label style="-fx-text-fill: white; -fx-font-size: 22px; -fx-font-weight: bold;" text="SISTEMA DE GERENCIAMENTO DE SENHAS" />
                <Region HBox.hgrow="ALWAYS" />
                <Label style="-fx-text-fill: white; -fx-font-size: 14px;" text="Usuário: Master_User">
                    <HBox.margin>
                        <Insets right="10.0" />
                    </HBox.margin>
                </Label>
                <Button onAction="#handleLogout" prefHeight="30.0" prefWidth="60.0" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-border-color: white; -fx-border-radius: 5;" text="Sair" />
            </children>
        </HBox>
    </top>

    <left>
        <VBox prefWidth="230.0" spacing="5.0" style="-fx-background-color: #0fe3f6;">
            <children>
                <Label style="-fx-text-fill: black; -fx-font-size: 18px; -fx-font-weight: bold; -fx-padding: 20 0 10 20;" text="MENU PRINCIPAL" />
                <Separator opacity="0.4" style="-fx-padding: 0 10 15 10;" />

                <Button fx:id="btnDashboard" alignment="BASELINE_LEFT" maxWidth="Infinity" onAction="#showDashboard" style="-fx-background-color: #0fe3f6; -fx-text-fill: black; -fx-padding: 12 20; -fx-font-size: 14px;" text="📊 Dashboard" />
                <Button fx:id="btnUsuarios" alignment="BASELINE_LEFT" maxWidth="Infinity" onAction="#showUsuarios" style="-fx-background-color: #0fe3f6; -fx-text-fill: black; -fx-padding: 12 20; -fx-font-size: 14px;" text="👥 Usuários" />
                <Button fx:id="btnServicos" alignment="BASELINE_LEFT" maxWidth="Infinity" onAction="#showServicos" style="-fx-background-color: #0fe3f6; -fx-text-fill: black; -fx-padding: 12 20; -fx-font-size: 14px;" text="📋 Tipos de Atendimento" />
                <Button fx:id="btnGuiches" alignment="BASELINE_LEFT" maxWidth="Infinity" onAction="#showGuiches" style="-fx-background-color: #0fe3f6; -fx-text-fill: black; -fx-padding: 12 20; -fx-font-size: 14px;" text="🏢 Guichês" />
                <Button alignment="BASELINE_LEFT" maxWidth="Infinity" onAction="#showConfigTotem" style="-fx-background-color: #0fe3f6; -fx-text-fill: black; -fx-padding: 12 20; -fx-font-size: 14px;" text="🎯 Config. Totem" />
                <Button alignment="BASELINE_LEFT" maxWidth="Infinity" onAction="#showConfigPainel" style="-fx-background-color: #0fe3f6; -fx-text-fill: black; -fx-padding: 12 20; -fx-font-size: 14px;" text="🖥 Config. Painel" />
                <Button alignment="BASELINE_LEFT" maxWidth="Infinity" onAction="#showModelosSenha" style="-fx-background-color: #0fe3f6; -fx-text-fill: black; -fx-padding: 12 20; -fx-font-size: 14px;" text="📑 Modelos de Senha" />
                <Button alignment="BASELINE_LEFT" maxWidth="Infinity" onAction="#showConfiguracoes" style="-fx-background-color: #0fe3f6; -fx-text-fill: black; -fx-padding: 12 20; -fx-font-size: 14px;" text="⚙ Configurações" />
                <Button alignment="BASELINE_LEFT" maxWidth="Infinity" onAction="#showRelatorios" style="-fx-background-color: #0fe3f6; -fx-text-fill: black; -fx-padding: 12 20; -fx-font-size: 14px;" text="📈 Relatórios" />
            </children>
        </VBox>
    </left>

    <center>
        <ScrollPane fitToHeight="true" fitToWidth="true" style="-fx-background-color: #eeeeee; -fx-background: #eeeeee;">
            <content>
                <StackPane fx:id="contentArea">
                    <padding>
                        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                    </padding>
                </StackPane>
            </content>
        </ScrollPane>
    </center>

    <bottom>
        <HBox alignment="CENTER_LEFT" prefHeight="30.0" style="-fx-background-color: #5693f5; -fx-padding: 0 15 0 15;">
            <children>
                <Label style="-fx-text-fill: white; -fx-font-size: 12px;" text="Sistema de Gerenciamento de Senhas v1.0 © 2026" />
                <Region HBox.hgrow="ALWAYS" />
                <Label fx:id="lblDataHora" style="-fx-text-fill: white; -fx-font-size: 12px;" text="Aguardando atualização..." />
            </children>
        </HBox>
    </bottom>
</BorderPane>