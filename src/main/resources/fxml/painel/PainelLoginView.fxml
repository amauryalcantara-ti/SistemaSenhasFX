<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="com.sistemasenhas.views.painel.PainelLoginController"
      style="-fx-background-color: #f8f9fa; -fx-padding: 15;"
      alignment="CENTER" prefWidth="350" prefHeight="300">
    
    <children>
        <!-- Cabeçalho -->
        <HBox style="-fx-background-color: #2c3e50; -fx-padding: 12;" alignment="CENTER_LEFT">
            <Label text="SISTEMA DE SENHAS"
                   style="-fx-text-fill: white; -fx-font-size: 14; -fx-font-weight: bold;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="lblNomeEmpresa" text="EMPRESA"
                   style="-fx-text-fill: white; -fx-font-size: 12; -fx-font-weight: normal;"/>
        </HBox>
        
        <!-- Conteúdo Principal -->
        <VBox alignment="CENTER" spacing="15" style="-fx-padding: 20;">
            <children>
                <!-- Título -->
                <Label text="LOGIN DO PAINEL"
                       style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #2c3e50;">
                    <font>
                        <Font name="Arial" size="18"/>
                    </font>
                </Label>
                
                <!-- Formulário -->
                <VBox spacing="10" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 6; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 6, 0, 0, 0);">
                    <children>
                        <!-- Campo Login -->
                        <VBox spacing="3">
                            <children>
                                <Label text="Login:" style="-fx-font-size: 12; -fx-font-weight: bold; -fx-text-fill: #34495e;"/>
                                <TextField fx:id="txtLogin" 
                                         promptText="PainelAmbulatorio"
                                         style="-fx-font-size: 13; -fx-pref-height: 32; -fx-pref-width: 250; -fx-border-color: #bdc3c7; -fx-border-radius: 4; -fx-background-radius: 4;"/>
                            </children>
                        </VBox>
                        
                        <!-- Campo Senha -->
                        <VBox spacing="3">
                            <children>
                                <Label text="Senha:" style="-fx-font-size: 12; -fx-font-weight: bold; -fx-text-fill: #34495e;"/>
                                <PasswordField fx:id="txtSenha" 
                                             promptText="Painel123"
                                             style="-fx-font-size: 13; -fx-pref-height: 32; -fx-pref-width: 250; -fx-border-color: #bdc3c7; -fx-border-radius: 4; -fx-background-radius: 4;"/>
                            </children>
                        </VBox>
                        
                        <!-- Mensagem de erro -->
                        <Label fx:id="lblMensagem" text="" 
                               style="-fx-font-size: 10; -fx-font-style: italic; -fx-wrap-text: true; -fx-pref-width: 250;"/>
                        
                        <!-- Botões -->
                        <HBox spacing="8" alignment="CENTER">
                            <children>
                                <Button fx:id="btnEntrar" text="ENTRAR" 
                                       style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-size: 13; -fx-font-weight: bold; -fx-pref-height: 32; -fx-pref-width: 85; -fx-background-radius: 4; -fx-cursor: hand;"/>
                                
                                <Button fx:id="btnConfigurarBD" text="CONFIG BD" 
                                       style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-font-size: 13; -fx-font-weight: bold; -fx-pref-height: 32; -fx-pref-width: 90; -fx-background-radius: 4; -fx-cursor: hand;"/>
                            </children>
                        </HBox>
                    </children>
                </VBox>
                
                <!-- Informações -->
                <Label text="Use: Painel + Local"
                       style="-fx-font-size: 10; -fx-text-fill: #7f8c8d; -fx-font-style: italic;"/>
            </children>
        </VBox>
        
        <!-- Rodapé -->
        <HBox style="-fx-background-color: #2c3e50; -fx-padding: 8;" alignment="CENTER" VBox.vgrow="ALWAYS">
            <children>
                <Label fx:id="lblDataHora" text="" 
                       style="-fx-text-fill: white; -fx-font-size: 11; -fx-font-weight: normal;">
                    <font>
                        <Font name="Arial" size="11"/>
                    </font>
                </Label>
            </children>
        </HBox>
    </children>
</VBox>
