<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.image.ImageView?>

<ScrollPane fitToHeight="true" fitToWidth="true" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.sistemasenhas.views.admin.guiches.TipoAtendimentoController">
    <content>
        <HBox spacing="10" style="-fx-background-color: white;">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>

            <VBox spacing="10" HBox.hgrow="ALWAYS">
                <Label text="Serviços Cadastrados" style="-fx-font-weight: bold;"/>
                <TableView fx:id="tvServicos" prefHeight="250" maxWidth="Infinity" minWidth="312">
                    <columns>
                        <TableColumn fx:id="colPrefixo" text="Sigla" minWidth="60" prefWidth="80" sortable="true" />
                        <TableColumn fx:id="colDescricao" text="Descrição" minWidth="150" prefWidth="250" sortable="true" />
                    </columns>
                </TableView>

                <Separator/>

                <Label text="Serviços Habilitados" style="-fx-font-weight: bold;"/>
                <ScrollPane fitToWidth="true" minHeight="200" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent; -fx-border-color: #dee2e6;">
                    <content>
                        <FlowPane fx:id="fpServicosHabilitados" hgap="10" vgap="10" style="-fx-padding: 10; -fx-background-color: #f8f9fa;" />
                    </content>
                </ScrollPane>
            </VBox>

            <!-- Lista de serviços do local para seleção múltipla -->
            <VBox spacing="6" prefWidth="240" minWidth="220" style="-fx-background-color: #ffffff; -fx-padding: 6; -fx-border-color: #e6e6e6; -fx-border-radius: 4;">
                <Label text="Serviços do Local" style="-fx-font-weight: bold;"/>
                <ListView fx:id="lvServicosLocal" VBox.vgrow="ALWAYS" prefHeight="220" />
                <!-- Checkboxes rendered inline via cell factory; no extra action buttons needed -->
                <Label text="(Clique nas checkboxes para vincular/desvincular ao guichê selecionado)" style="-fx-font-size: 10px; -fx-text-fill: #666;" wrapText="true" />
            </VBox>

            <VBox spacing="8" prefWidth="320" minWidth="320" maxWidth="320" style="-fx-background-color: #f4f4f4; -fx-padding: 10; -fx-background-radius: 5;">
                <Label text="Personalização do Botão" style="-fx-font-weight: bold;"/>
                
                <Label text="Descrição:"/>
                <TextField fx:id="txtDescricao" />
                
                <Label text="Formato do Botão:"/>
                <ComboBox fx:id="cbFormato" maxWidth="Infinity" />
                
                <HBox spacing="5">
                    <VBox HBox.hgrow="ALWAYS">
                        <Label text="Cor Fundo:"/>
                        <ColorPicker fx:id="cpFundo" maxWidth="Infinity" minHeight="35"/>
                    </VBox>
                    <VBox HBox.hgrow="ALWAYS">
                        <Label text="Cor Fonte:"/>
                        <ColorPicker fx:id="cpTexto" maxWidth="Infinity" minHeight="35"/>
                    </VBox>
                </HBox>

                <Label text="Estilo da Fonte:"/>
                <ComboBox fx:id="cbFonte" maxWidth="Infinity" minHeight="30"/>

                <HBox spacing="5" alignment="CENTER_LEFT">
                    <Button text="Escolher Ícone" onAction="#selecionarIcone" />
                    <ImageView fx:id="imgPreview" fitHeight="24" fitWidth="24" preserveRatio="true"/>
                </HBox>

                <Separator/>
                <Label text="Preview:"/>
                <StackPane fx:id="panePreview" minHeight="140" VBox.vgrow="ALWAYS" style="-fx-border-color: #ccc; -fx-border-style: dashed; -fx-background-color: white;"/>

                <GridPane hgap="5" vgap="5">
                    <columnConstraints>
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints minHeight="40.0" prefHeight="40.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="40.0" prefHeight="40.0" vgrow="SOMETIMES" />
                    </rowConstraints>
                    <children>
                        <!-- Buttons side by side: Save and Delete -->
                        <Button text="Salvar" onAction="#salvareLimpar" maxWidth="Infinity" maxHeight="36"
                                style="-fx-background-color: #0078D4; -fx-text-fill: white; -fx-font-weight: bold;" 
                                GridPane.columnIndex="0"/>

                        <Button text="Excluir" onAction="#excluir" maxWidth="Infinity" maxHeight="36"
                                style="-fx-background-color: #dc3545; -fx-text-fill: white; -fx-font-weight: bold;" 
                                GridPane.columnIndex="1"/>

                        <Button fx:id="btnAdicionarHabilitado" text="Adicionar aos Habilitados" onAction="#adicionarAosHabilitados" maxWidth="Infinity" maxHeight="36"
                                style="-fx-background-color: #17a2b8; -fx-text-fill: white; -fx-font-weight: bold;" 
                                GridPane.rowIndex="1" GridPane.columnSpan="2"/>
                    </children>
                </GridPane>
            </VBox>

            <VBox spacing="8" prefWidth="250" minWidth="200">
                <Label text="Habilitar para:" style="-fx-font-weight: bold;"/>
                <Label text="Locais (Totens):" style="-fx-font-size: 11px;"/>
                <ListView fx:id="lvLocais" VBox.vgrow="ALWAYS" />
                <Label text="Guichês (Atendentes):" style="-fx-font-size: 11px;"/>
                <ListView fx:id="lvGuiches" VBox.vgrow="ALWAYS" />
            </VBox>
        </HBox>
    </content>
</ScrollPane>