<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="700.0" prefWidth="1000.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.sistemasenhas.views.admin.locais.LocaisController">
    <top>
        <VBox style="-fx-background-color: #1a237e; -fx-padding: 15;">
            <Label style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold;" text="LOCAIS DE ATENDIMENTO" />
        </VBox>
    </top>
    <center>
        <VBox spacing="20" style="-fx-padding: 20;">
            <VBox spacing="10" style="-fx-background-color: #f8f9fa; -fx-padding: 20; -fx-border-radius: 5; -fx-border-color: #dee2e6;">
                <GridPane hgap="15" vgap="10">
                    <columnConstraints>
                        <ColumnConstraints prefWidth="120" />
                        <ColumnConstraints prefWidth="400" />
                    </columnConstraints>
                    <children>
                        <Label text="Nome do Local:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                        <TextField fx:id="txtNomeLocal" promptText="Ex: Recepção, Triagem, Sala 01" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                    </children>
                </GridPane>
                <HBox spacing="10" style="-fx-padding: 15 0 0 0;">
                    <Button fx:id="btnAdicionar" onAction="#handleAdicionarLocal" style="-fx-background-color: #28a745; -fx-text-fill: white; -fx-font-weight: bold;" text="Adicionar Local" />
                </HBox>
            </VBox>

            <TableView fx:id="tableViewLocais" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colId" prefWidth="100" text="ID" />
                    <TableColumn fx:id="colNome" prefWidth="500" text="Nome do Local" />
                </columns>
            </TableView>
        </VBox>
    </center>
</BorderPane>