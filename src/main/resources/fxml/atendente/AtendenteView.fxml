<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns:fx="http://javafx.com/fxml" 
    fx:controller="com.sistemasenhas.views.atendente.AtendenteController"
    style="-fx-background-color: #f5f5f5;">

    <!-- TOPO COM BARRA DE TÍTULO -->
    <top>
        <VBox>
            <!-- Barra de título estilo Windows -->
            <HBox style="-fx-background-color: #2c3e50; -fx-padding: 10;" alignment="CENTER_LEFT">
                <Label fx:id="lblNomeSistema" text="SISTEMA DE GERENCIAMENTO DE SENHAS" 
                    style="-fx-text-fill: white; -fx-font-size: 16; -fx-font-weight: bold;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="lblNomeEmpresa" text="EMPRESA" 
                    style="-fx-text-fill: white; -fx-font-size: 14; -fx-font-weight: normal;"/>
            </HBox>
            
            <!-- Barra de informações do usuário -->
            <HBox style="-fx-background-color: #34495e; -fx-padding: 10;" alignment="CENTER_LEFT">
                <Label fx:id="lblNomeUsuario" text="Usuário: Carregando..." 
                    style="-fx-text-fill: white; -fx-font-size: 14; -fx-font-weight: bold;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="lblTempoAtividade" text="Tempo ativo: 00:00:00" 
                    style="-fx-text-fill: #3498db; -fx-font-size: 14; -fx-font-weight: bold;"/>
            </HBox>
            
            <!-- Barra de pausa/retomada -->
            <HBox style="-fx-background-color: #f39c12; -fx-padding: 8;" alignment="CENTER">
                <Button fx:id="btnPausarLogin" text="⏸ PAUSAR LOGIN" 
                    style="-fx-background-color: #e67e22; -fx-text-fill: white; -fx-font-size: 12; -fx-font-weight: bold; -fx-pref-width: 150; -fx-pref-height: 30; -fx-background-radius: 5;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="btnRetomarLogin" text="▶ RETOMAR LOGIN" 
                    style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-size: 12; -fx-font-weight: bold; -fx-pref-width: 150; -fx-pref-height: 30; -fx-background-radius: 5;" 
                    disable="true"/>
            </HBox>
        </VBox>
    </top>

    <!-- CONTEÚDO PRINCIPAL -->
    <center>
        <HBox spacing="15" style="-fx-padding: 15;">
            <!-- ÁREA DE SERVIÇOS (ESQUERDA) -->
            <VBox spacing="10" style="-fx-background-color: white; -fx-padding: 15; -fx-border-radius: 8; -fx-border-color: #ddd; -fx-border-width: 1;" prefWidth="400">
                <Label text="SERVIÇOS DISPONÍVEIS" 
                    style="-fx-text-fill: #2c3e50; -fx-font-size: 16; -fx-font-weight: bold;"/>
                <Separator/>
                
                <VBox fx:id="containerServicos" spacing="8">
                    <!-- Botões de serviços serão carregados dinamicamente -->
                    <Label text="Carregando serviços..." 
                        style="-fx-text-fill: #7f8c8d; -fx-font-size: 12; -fx-font-style: italic;"/>
                </VBox>
            </VBox>

            <!-- ÁREA DE INFORMAÇÕES (DIREITA) -->
            <VBox spacing="10" HBox.hgrow="ALWAYS">
                <!-- Últimas senhas chamadas -->
                <VBox style="-fx-background-color: white; -fx-padding: 15; -fx-border-radius: 8; -fx-border-color: #ddd; -fx-border-width: 1;">
                    <Label text="ÚLTIMAS SENHAS CHAMADAS" 
                        style="-fx-text-fill: #2c3e50; -fx-font-size: 14; -fx-font-weight: bold;"/>
                    <Separator/>
                    
                    <VBox fx:id="containerUltimasSenhas" spacing="5">
                        <Label text="Nenhuma senha chamada ainda" 
                            style="-fx-text-fill: #95a5a6; -fx-font-size: 11; -fx-font-style: italic;"/>
                    </VBox>
                </VBox>

                <!-- Quantidade por tipo -->
                <VBox style="-fx-background-color: white; -fx-padding: 15; -fx-border-radius: 8; -fx-border-color: #ddd; -fx-border-width: 1;">
                    <Label text="QUANTIDADE POR TIPO" 
                        style="-fx-text-fill: #2c3e50; -fx-font-size: 14; -fx-font-weight: bold;"/>
                    <Separator/>
                    
                    <VBox fx:id="containerQuantidadePorTipo" spacing="5">
                        <Label text="Carregando estatísticas..." 
                            style="-fx-text-fill: #95a5a6; -fx-font-size: 11; -fx-font-style: italic;"/>
                    </VBox>
                </VBox>

                <!-- Botões de ação -->
                <VBox style="-fx-background-color: white; -fx-padding: 15; -fx-border-radius: 8; -fx-border-color: #ddd; -fx-border-width: 1;">
                    <Label text="AÇÕES" 
                        style="-fx-text-fill: #2c3e50; -fx-font-size: 14; -fx-font-weight: bold;"/>
                    <Separator/>
                    
                    <Button fx:id="btnEncerrarAtendimento" text="⏹ ENCERRAR ATENDIMENTO ATUAL" 
                        style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-size: 12; -fx-font-weight: bold; -fx-pref-height: 40; -fx-background-radius: 5;" 
                        disable="true"/>
                </VBox>
            </VBox>
        </HBox>
    </center>

    <!-- RODAPÉ -->
    <bottom>
        <HBox alignment="CENTER_LEFT" prefHeight="30.0" style="-fx-background-color: #5693f5; -fx-padding: 0 15 0 15;">
            <children>
                <Label style="-fx-text-fill: white; -fx-font-size: 12px;" text="Sistema de Gerenciamento de Senhas v1.0 2026" />
                <Region HBox.hgrow="ALWAYS" />
                <Label fx:id="lblDataHoraCompleta" style="-fx-text-fill: white; -fx-font-size: 12px;" text="Aguardando atualização..." />
            </children>
        </HBox>
    </bottom>

</BorderPane>